<Project Sdk="MSTest.Sdk/4.3.3">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>Tests</AssemblyName>
		<RootNamespace>Sungaila.NewDark.Tests</RootNamespace>
		<IsTrimmable>true</IsTrimmable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<!-- C# compiler -->
	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<Features>strict</Features>
		<WarningsAsErrors>nullable</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\Core.csproj" />
		<ProjectReference Include="..\GlobalServer\NewDarkGlobalServer.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
		<PackageReference Update="Microsoft.Testing.Extensions.TrxReport" Version="2.3.3" />
		<PackageReference Update="MSTest.TestAdapter" Version="4.3.3" />
		<PackageReference Update="MSTest.TestFramework" Version="4.3.3" />
	</ItemGroup>

</Project>